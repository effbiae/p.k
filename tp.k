\l p.k
/" "\"x;y (x;y) f[x;y] x+y x+*y 1+3*x (+x)%y (+/x)%#x x+m[*i]/y 1+3+-: 9(+\\|:)\\2#1"
/`0:({x,(17-#x)#" "}'"p",/:`k@'vs),' " / ",/:`k@'p@/:vs
tests:(("";GAP)
 ("x;y"            ; ("[";,`x;,`y))
 ("(x;y)"          ; ("(";,`x;,`y))
 ("f[x;y]"         ; (,`f;,`x;,`y))
 ("x+y"            ; (+;,`x;,`y))
 ("x+*y"           ; (+;,`x;(*:;,`y)))
 ("1+3*x"          ; (+;1;(*;3;,`x)))
 ("(+x)%y"         ; (%;(+:;,`x);,`y))
 ("(+/x)%#x"       ; (%;((/;+);,`x);(#:;,`x)))
 ("x+m[*i]/y"      ; (+;,`x;((/;(,`m;(*:;,`i)));,`y)))
 ("1+3+-:"         ; (';(+;1;GAP);(';(+;3;GAP);-:)))
 ("9(+\\|:)\\2#1"  ; ((\;(';(\;+);|:));9;(#;2;1)))
 ("f:+"            ; (:;,`f;+))
 ("f++"            ; (';(+;,`f;GAP);+))
 ("(++|:)1"        ; ((';+:;(';+:;|:));1))
 ("k.k"            ; (,`"k.k"))
 (".k"             ; (.:;,`k)) )
test:{r:p[x]~y;$[~r;`0:"p[",(`k@x),"] is ",`k@p x;];r}
`exit@~&/(()~*pf@"";&/test.'tests)
